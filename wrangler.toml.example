name = "vizitka-contact-relay"
main = "worker.js"
compatibility_date = "2026-04-21"

[[kv_namespaces]]
binding = "CONTACT_KV"
id = "PUT_YOUR_KV_NAMESPACE_ID_HERE"

[vars]
ALLOWED_ORIGIN = "https://maxfullstack.com"
# Must be a sender verified in Resend (domain or onboarding@resend.dev for testing).
CONTACT_FROM_EMAIL = "Max Full Stack <contact@maxfullstack.com>"

# Secrets (wrangler secret put … — never commit real values):
# RESEND_API_KEY   — API key from https://resend.com/api-keys
# CONTACT_TO_EMAIL — inbox that receives form submissions (e.g. you@maxfullstack.com)
